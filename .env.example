# ==============================================================================
#                      SIBSAU_BOT CONFIGURATION FILE
# ==============================================================================

# --- [Telegram Bot Settings] ---
# Токен бота, полученный от @BotFather (ОБЯЗАТЕЛЬНО)
TOKEN=1234567890:ABCdefGhIjkLmNoPqRsTuVwXyZ123456789

# Telegram ID владельца бота (число) (ОБЯЗАТЕЛЬНО)
OWNER_ID=123456789

# Ссылка на страницу расписания группы в АСУ Паллада (ОБЯЗАТЕЛЬНО)
SCHEDULE_URL=https://timetable.pallada.sibsau.ru/timetable/group/XXXXX

# Ссылка на учебный план группы (необязательно)
PLAN_URL=https://docs.google.com/spreadsheets/d/XXXXX/edit

# Дата начала семестра (ГГГГ-ММ-ДД, необязательно, по умолчанию рассчитывается динамически)
# SEMESTER_START=2026-09-01

# Часовой пояс бота (по умолчанию Красноярск Asia/Krasnoyarsk UTC+7)
TIMEZONE=Asia/Krasnoyarsk


# --- [Flask Web Admin Panel] ---
# Секретный ключ для подписи сессий и CSRF токенов (сгенерируйте случайную строку)
FLASK_SECRET=change_this_super_secret_random_key_for_production

# Логин и пароль для мастер-входа в веб-панель
PANEL_USER=admin
PANEL_PASS=ChangeThisStrongPassword123!

# Порт веб-панели (по умолчанию 19999)
PANEL_PORT=19999

# Внешний адрес / домен / DDNS панели для генерации ссылок авторизации в боте (/web)
# Оставьте пустым для автоматического определения внешнего IP сервера
PANEL_URL=


# --- [SSL / HTTPS Encryption] ---
# Пути к сертификату и ключу для запуска веб-панели по HTTPS
# Относительно корня проекта (например ssl/self_signed.crt) или абсолютные пути
SSL_CERT=ssl/self_signed.crt
SSL_KEY=ssl/self_signed.key


# --- [Security & 2FA] ---
# Секрет для двухфакторной аутентификации TOTP (оставьте пустым для генерации при первом старте)
# TOTP_SECRET=JBSWY3DPEHPK3PXP


# --- [Logging & Network] ---
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Прокси для запросов бота к Telegram API (HTTP / SOCKS5 / VLESS Xray)
# PROXY_URL=http://127.0.0.1:10808
